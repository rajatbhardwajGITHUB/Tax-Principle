### API Test Collection
### Use with VS Code REST Client extension.
### Update @baseUrl if your server runs on a different host/port.

@baseUrl = http://localhost:8080
@contentType = application/json
@userEmail = user1@example.com
@userPassword = User@12345
@userPhone = 9999999999
@adminEmail = admin1@example.com
@adminPassword = Admin@12345
@adminPhone = 8888888888
@otp = 123456
@accessToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJ1c2VyMUBleGFtcGxlLmNvbSIsImlhdCI6MTc3Mjk2Mzk2MiwiZXhwIjoxNzcyOTY0ODYyfQ.BndrX-2-Uz7XOWkdBT7IaO-Taaziw4BMtk-roefVNh9OjHKfeNB_yi4_yH2deEZdpo1JPk54onw0G6f2HGyk1w
@refreshToken = eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJ1c2VyMUBleGFtcGxlLmNvbSIsImlhdCI6MTc3Mjk2NDAzMCwiZXhwIjoxNzczNTY4ODMwfQ.c1vcBBH_046ZJd-JhmXdqa1mj9Xa-51OvZJD55jtcJem7FHb8Y5AUwvP6nQX4J9OSX4WwO42I9puzJoLhY3UAg
@serviceId = 1
@purchaseId = 1

### ------------------------------------------------------------
### Health / sanity
### ------------------------------------------------------------
GET {{baseUrl}}/actuator/health

### ------------------------------------------------------------
### Phase 1: Auth
### ------------------------------------------------------------

### Register USER - Initiate OTP
POST {{baseUrl}}/auth/register/initiate
Content-Type: {{contentType}}

{
  "name": "User One",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}",
  "phoneNumber": "{{userPhone}}",
  "role": "USER"
}

### Register USER - Verify OTP
POST {{baseUrl}}/auth/register/verify
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "otp": "{{otp}}"
}

### Register ADMIN - Initiate OTP
POST {{baseUrl}}/auth/register/initiate
Content-Type: {{contentType}}

{
  "name": "Admin One",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "phoneNumber": "{{adminPhone}}",
  "role": "ADMIN"
}

### Register ADMIN - Verify OTP
POST {{baseUrl}}/auth/register/verify
Content-Type: {{contentType}}

{
  "email": "{{adminEmail}}",
  "otp": "{{otp}}"
}

### Login USER - Initiate OTP
POST {{baseUrl}}/auth/login/initiate
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Login USER - Verify OTP
POST {{baseUrl}}/auth/login/verify
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "otp": "{{otp}}"
}

### Login ADMIN - Initiate OTP
POST {{baseUrl}}/auth/login/initiate
Content-Type: {{contentType}}

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Login ADMIN - Verify OTP
POST {{baseUrl}}/auth/login/verify
Content-Type: {{contentType}}

{
  "email": "{{adminEmail}}",
  "otp": "{{otp}}"
}

### Forgot password (send OTP)
POST {{baseUrl}}/auth/password/forgot
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}"
}

### Reset password with OTP
POST {{baseUrl}}/auth/password/reset
Content-Type: {{contentType}}

{
  "email": "{{userEmail}}",
  "otp": "{{otp}}",
  "newPassword": "NewUser@12345"
}

### Refresh token
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------
### Phase 2: Service Catalog
### ------------------------------------------------------------

### USER - List active services
GET {{baseUrl}}/service/user/services
Authorization: Bearer {{accessToken}}

### USER - Get service detail
GET {{baseUrl}}/service/user/services/{{serviceId}}
Authorization: Bearer {{accessToken}}

### ADMIN - Create service
POST {{baseUrl}}/service/admin/services
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "code": "GST-FILING",
  "name": "GST Filing",
  "description": "Monthly GST filing support",
  "price": 499.00,
  "active": true
}

### ADMIN - Update service
PUT {{baseUrl}}/service/admin/services/updateService/{{serviceId}}
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "GST Filing Pro",
  "description": "Updated plan",
  "price": 699.00,
  "active": true
}

### ADMIN - Change service status
PATCH {{baseUrl}}/service/admin/services/updatedStatus/{{serviceId}}?status=false
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------
### Phase 3: Purchases + Tracking
### ------------------------------------------------------------

### USER - Create purchase
POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "serviceId": {{serviceId}},
  "paymentReference": "PAY-TEST-0001"
}

### USER - List my purchases
GET {{baseUrl}}/purchases/me?page=0&size=10&sort=purchasedAt,desc
Authorization: Bearer {{accessToken}}

### USER - Purchase detail
GET {{baseUrl}}/purchases/me/{{purchaseId}}
Authorization: Bearer {{accessToken}}

### ADMIN - List all purchases
GET {{baseUrl}}/admin/purchases?page=0&size=10&sort=purchasedAt,desc
Authorization: Bearer {{accessToken}}

### ADMIN - Purchase detail
GET {{baseUrl}}/admin/purchases/{{purchaseId}}
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------
### Phase 4: Dashboard
### ------------------------------------------------------------

### USER - Dashboard purchase table
GET {{baseUrl}}/dashboard/me/purchases?from=2026-01-01&to=2026-12-31&page=0&size=10
Authorization: Bearer {{accessToken}}

### ADMIN - Dashboard purchases
GET {{baseUrl}}/admin/dashboard/purchases?from=2026-01-01&to=2026-12-31&page=0&size=10
Authorization: Bearer {{accessToken}}

### ADMIN - Dashboard metrics
GET {{baseUrl}}/admin/dashboard/metrics?from=2026-01-01&to=2026-12-31
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------
### Authorization checks (expected: 403 for USER token on admin routes)
### ------------------------------------------------------------

### USER token should fail on admin route
GET {{baseUrl}}/admin/purchases?page=0&size=10
Authorization: Bearer {{accessToken}}
